play: grid; place-items: center; width: 32px; height: 32px; min-width: 0; min-height: 0; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; box-shadow: none; cursor: pointer; }\n  .dr-avis .dr-avis__dot::before { content: ''; display: block; width: 8px; height: 8px; border-radius: 50%; background: #c9d7ce; transition: background-color .2s; }\n  .dr-avis .dr-avis__dot[aria-current='true']::before { background: #16714b; }\n  .dr-avis .dr-avis__pause { min-width: 0; min-height: 32px; margin: 0; padding: 4px 10px; border: 0; border-radius: 4px; background: transparent; box-shadow: none; color: #3d5e4c; font: inherit; font-size: 12px; letter-spacing: normal; text-transform: none; cursor: pointer; }\n  .dr-avis .dr-avis__dot:focus-visible, .dr-avis .dr-avis__pause:focus-visible, .dr-avis .dr-avis__track:focus-visible { outline: 2px solid #16714b; outline-offset: -2px; }\n  @media (max-width: 768px) {\n    .dr-avis { padding-top: 24px; }\n    .dr-avis .dr-avis__header { padding-inline: 16px; }\n    .dr-avis .dr-avis__card { flex-basis: 86%; max-width: 340px; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .dr-avis .dr-avis__dot::before { transition: none; }\n  }\n</style>\n\n<script>\n(function () {\n  if (window.DrainelleReviewsV1) {\n    window.DrainelleReviewsV1.init(document);\n    return;\n  }\n  var instances = new WeakMap();\n\n  function mount(root) {\n    if (instances.has(root)) return;\n    var track = root.querySelector('.dr-avis__track');\n    var cards = Array.from(root.querySelectorAll('.dr-avis__card'));\n    var controls = root.querySelector('.dr-avis__controls');\n    var dots = root.querySelector('.dr-avis__dots');\n    var pauseButton = root.querySelector('.dr-avis__pause');\n    if (!track || !cards.length || !controls || !dots || !pauseButton) return;\n\n    var motion = window.matchMedia('(prefers-reduced-motion: reduce)');\n    var paused = motion.matches;\n    var hovered = false;\n    var touching = false;\n   