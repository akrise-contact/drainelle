istener('click', function () { goTo(index); start(); });\n        dots.appendChild(dot);\n      });\n      controls.hidden = points.length < 2;\n      update();\n      start();\n    }\n    function updatePause() {\n      pauseButton.textContent = paused ? 'Activer le défilement' : 'Mettre en pause';\n      pauseButton.setAttribute('aria-label', paused ? 'Activer le défilement automatique des témoignages' : 'Mettre en pause le défilement automatique des témoignages');\n    }\n    listen(pauseButton, 'click', function () { paused = !paused; updatePause(); start(); });\n    listen(root, 'mouseenter', function () { hovered = true; stop(); });\n    listen(root, 'mouseleave', function () { hovered = false; start(); });\n    listen(root, 'focusin', function () { focused = true; stop(); });\n    listen(root, 'focusout', function (event) { focused = !!event.relatedTarget && root.contains(event.relatedTarget); start(); });\n    listen(track, 'touchstart', function () { touching = true; stop(); }, { passive: true });\n    listen(track, 'touchend', function () { touching = false; start(); }, { passive: true });\n    listen(track, 'touchcancel', function () { touching = false; start(); }, { passive: true });\n    listen(track, 'scroll', function () {\n      if (frame !== null) return;\n      frame = requestAnimationFrame(function () { frame = null; update(); });\n    }, { passive: true });\n    listen(document, 'visibilitychange', start);\n    listen(motion, 'change', function () { paused = motion.matches; updatePause(); start(); });\n\n    var observer = window.ResizeObserver ? new ResizeObserver(measure) : null;\n    if (observer) observer.observe(track);\n    else listen(window, 'resize', measure);\n    instances.set(root, function () {\n      stop();\n      if (frame !== null) cancelAnimationFrame(frame);\n      if (observer) observer.disconnect();\n      removers.forEach(function (remove) { remove(); });\n      instances.delete(root);\n    });\n    updatePause();\n    measu